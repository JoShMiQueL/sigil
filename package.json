{
  "name": "sigil",
  "version": "0.0.0",
  "private": true,
  "description": "Modern game server management panel",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '@sigil/*' build",
    "dev": "bun run --filter '@sigil/*' --parallel dev",
    "lint": "biome lint",
    "format": "biome format --write",
    "format:check": "biome format --check",
    "check": "biome check",
    "typecheck": "bun run --filter '@sigil/*' typecheck",
    "test": "bun run --filter '@sigil/*' test",
    "test:e2e": "bun run scripts/run-e2e.ts",
    "dev:services": "docker compose -f infra/docker/docker-compose.dev.yml up -d",
    "dev:services:down": "docker compose -f infra/docker/docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.0.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "testcontainers": "^12.0.4",
    "typescript": "^7.0.2"
  }
}
