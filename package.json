{
  "name": "sigilpanel",
  "version": "0.0.0",
  "private": true,
  "description": "Modern game server management panel",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome lint",
    "format": "biome format --write",
    "format:check": "biome format --check",
    "check": "biome check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:services": "docker compose -f infra/docker/docker-compose.dev.yml up -d",
    "dev:services:down": "docker compose -f infra/docker/docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^24.0.0",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  }
}
